{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Makolo — ADB Reverse Samsung USB",
      "type": "process",
      "command": "adb",
      "args": [
        "-s",
        "RFCNA0800DA",
        "reverse",
        "tcp:9999",
        "tcp:9999"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Makolo — ADB Reverse Emulator",
      "type": "process",
      "command": "adb",
      "args": [
        "-s",
        "emulator-5554",
        "reverse",
        "tcp:9999",
        "tcp:9999"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Makolo — Démarrer émulateur Android",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-Command",
        "$ErrorActionPreference = 'Stop'\n$id = 'emulator-5554'\n$devices = @(adb devices)\n$found = @($devices | Where-Object { $_ -match ('^' + [regex]::Escape($id) + '\\s+') }).Count -gt 0\nif (-not $found) {\n  flutter emulators --launch Makolo_API_35\n  if ($LASTEXITCODE -ne 0) { throw 'Impossible de lancer l emulateur Makolo_API_35.' }\n}\n$ready = $false\nfor ($i = 0; $i -lt 120; $i++) {\n  $state = (adb -s $id get-state 2>$null | Out-String).Trim()\n  if ($LASTEXITCODE -eq 0 -and $state -eq 'device') {\n    $boot = (adb -s $id shell getprop sys.boot_completed 2>$null | Out-String).Trim()\n    if ($LASTEXITCODE -eq 0 -and $boot -eq '1') { $ready = $true; break }\n  }\n  Start-Sleep -Seconds 2\n}\nif (-not $ready) { throw 'Emulateur non pret. Verifiez Android Device Manager et adb devices.' }\nWrite-Host 'Makolo : emulateur Android pret'"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Makolo — Activer clavier émulateur",
      "type": "process",
      "command": "adb",
      "args": [
        "-s",
        "emulator-5554",
        "shell",
        "settings",
        "put",
        "secure",
        "show_ime_with_hard_keyboard",
        "1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Makolo — Préparer émulateur local",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Makolo — Démarrer émulateur Android",
        "Makolo — Activer clavier émulateur",
        "Makolo — ADB Reverse Emulator"
      ],
      "problemMatcher": []
    },
    {
      "label": "Makolo — Préparer émulateur PythonAnywhere",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Makolo — Démarrer émulateur Android",
        "Makolo — Activer clavier émulateur"
      ],
      "problemMatcher": []
    }
  ]
}
