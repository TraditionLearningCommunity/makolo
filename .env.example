# Makolo environment reference — fictitious values only. Never commit real secrets.
# Production required: DJANGO_SECRET_KEY, DJANGO_ALLOWED_HOSTS, MAKOLO_PUBLIC_BASE_URL.

DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
MAKOLO_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Database — SQLite remains the current PythonAnywhere runtime.
DJANGO_DATABASE_ENGINE=sqlite
DJANGO_DB_PATH=db.sqlite3
DJANGO_SQLITE_TIMEOUT_SECONDS=20
# Future PostgreSQL example (do not enable on the current PythonAnywhere test deployment):
# DJANGO_DATABASE_ENGINE=postgresql
# DJANGO_DATABASE_NAME=makolo
# DJANGO_DATABASE_USER=makolo
# DJANGO_DATABASE_PASSWORD=replace-with-database-password
# DJANGO_DATABASE_HOST=db.example.internal
# DJANGO_DATABASE_PORT=5432
# DJANGO_DATABASE_CONN_MAX_AGE=60
# DJANGO_DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Files, uploads and local operational storage.
# DJANGO_STATIC_ROOT=/path/to/makolo/staticfiles
# DJANGO_MEDIA_ROOT=/path/to/makolo/media
# MAKOLO_BACKUP_DIR=/path/to/makolo/backups
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=12582912
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=3145728

# E-mail. Development/test normally uses console/locmem. PythonAnywhere beta may
# explicitly keep console while SMTP is not ready. A real production deployment
# should switch to SMTP (or another configured backend) via environment only.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_EMAIL_USE_SSL=False
# DJANGO_EMAIL_HOST_USER=makolo-smtp-user
# DJANGO_EMAIL_HOST_PASSWORD=replace-with-smtp-password
# DJANGO_DEFAULT_FROM_EMAIL=Makolo <noreply@example.com>
DJANGO_PASSWORD_RESET_TIMEOUT_SECONDS=3600

# Payment sandbox. In production, PAYMENTS_WEBHOOK_SECRET is mandatory whenever
# PAYMENTS_SANDBOX_ENABLED=True.
PAYMENTS_SANDBOX_ENABLED=True
PAYMENTS_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# Session/cookie policy.
DJANGO_SESSION_COOKIE_AGE_SECONDS=1209600
DJANGO_SESSION_EXPIRE_AT_BROWSER_CLOSE=False

# HTTPS/security policy (production defaults are already secure).
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_SECURE_HSTS_PRELOAD=False

# Logging and rotation.
# DJANGO_LOG_DIR=/path/to/makolo/logs
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_MAX_BYTES=5242880
DJANGO_LOG_BACKUP_COUNT=5

# E2E only.
# DJANGO_EMAIL_FILE_PATH=.e2e-emails

# Développement mobile local
# Lancez Django avec : python manage.py runserver 0.0.0.0:8000
# Navigateur local / iOS Simulator : http://127.0.0.1:8000
# Android Emulator (AVD) : http://10.0.2.2:8000
# Téléphone physique : http://<IP-LAN-DE-LA-MACHINE>:8000
# Pour un téléphone physique, ajoutez explicitement cette IP LAN à
# DJANGO_ALLOWED_HOSTS (ex. 127.0.0.1,localhost,192.168.1.42).
# N'utilisez jamais '*' pour assouplir ALLOWED_HOSTS en production.
# Flutter Android/iOS natif n'a pas besoin de CORS pour appeler cette API.
