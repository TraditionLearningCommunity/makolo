DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
MAKOLO_PUBLIC_BASE_URL=http://127.0.0.1:8000
PAYMENTS_SANDBOX_ENABLED=True
PAYMENTS_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
DJANGO_PASSWORD_RESET_TIMEOUT_SECONDS=3600

# Développement mobile local
# Lancez Django avec : python manage.py runserver 0.0.0.0:8000
# Navigateur local / iOS Simulator : http://127.0.0.1:8000
# Android Emulator (AVD) : http://10.0.2.2:8000
# Téléphone physique : http://<IP-LAN-DE-LA-MACHINE>:8000
# Pour un téléphone physique, ajoutez explicitement cette IP LAN à
# DJANGO_ALLOWED_HOSTS (ex. 127.0.0.1,localhost,192.168.1.42).
# N'utilisez jamais '*' pour assouplir ALLOWED_HOSTS en production.
# Flutter Android/iOS natif n'a pas besoin de CORS pour appeler cette API.

# Production e-mail example
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_DEFAULT_FROM_EMAIL=Makolo <noreply@example.com>
